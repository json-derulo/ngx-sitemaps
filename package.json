{
	"name": "ngx-sitemaps",
	"version": "0.4.0",
	"description": "Generate sitemaps from Angular prerendered routes",
	"main": "./src/index.js",
	"type": "module",
	"scripts": {
		"test": "vitest run --coverage",
		"prebuild": "node ./clean-dist.js",
		"build": "tsc",
		"postbuild": "cpy README.md sitemap.config.schema.json dist",
		"check-code-style": "prettier . --check"
	},
	"keywords": [
		"angular",
		"sitemap"
	],
	"exports": {
		".": "./src/index.js"
	},
	"bin": {
		"ngx-sitemaps": "src/cli.js"
	},
	"author": {
		"name": "Daniel Kimmich",
		"email": "json-derulo@outlook.com"
	},
	"license": "MIT",
	"repository": {
		"url": "git+https://github.com/json-derulo/ngx-sitemaps.git"
	},
	"homepage": "https://json-derulo.github.io/ngx-sitemaps/",
	"bugs": "https://github.com/json-derulo/ngx-sitemaps/issues",
	"funding": "https://github.com/sponsors/json-derulo",
	"dependencies": {
		"commander": "^15.0.0",
		"jsonc-parser": "^3.3.1",
		"xmlbuilder2": "^4.0.3"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"@vitest/coverage-v8": "4.1.10",
		"cpy-cli": "7.0.0",
		"prettier": "3.9.6",
		"tsx": "4.23.1",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@11.18.0"
}
